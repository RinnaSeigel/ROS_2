Ниже полный вариант `robot.urdf.xacro` в стиле «питомец‑помощник», сделанный на основе твоего второго файла (`robot.urdf copy.xacro`): база и лидар остаются, добавлены голова‑сфера, ушки, хвост и «мордочка» (глаза‑экраны и рот).[1][2][3]

```xml
<?xml version="1.0"?>
<robot name="robot" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find robot_description)/urdf/gazebo.urdf.xacro" />

  <!-- -------- ПАРАМЕТРЫ -------- -->
  <xacro:property name="chassis_length" value="0.335" />
  <xacro:property name="chassis_width"  value="0.265" />
  <xacro:property name="chassis_height" value="0.138" />

  <xacro:property name="wheel_radius"   value="${chassis_height * 1.3 / 2}" />
  <xacro:property name="wheel_thickness" value="0.06" />
  <xacro:property name="wheel_mass"     value="0.05" />
  <xacro:property name="wheel_offset_x" value="${chassis_length / 2 + 0.2 * chassis_length}" />
  <xacro:property name="wheel_offset_y" value="${chassis_width / 2 + wheel_thickness / 2}" />
  <xacro:property name="wheel_offset_z" value="${chassis_height / 2.0}" />

  <xacro:property name="caster_wheel_radius" value="0.03" />
  <xacro:property name="caster_wheel_mass"   value="0.01" />
  <xacro:property name="caster_wheel_offset_x" value="0.075" />
  <xacro:property name="caster_wheel_offset_z"
                  value="${wheel_offset_z - wheel_radius + caster_wheel_radius}" />

  <xacro:property name="mass" value="1.0" />

  <xacro:property name="laser_radius" value="0.05" />
  <xacro:property name="laser_length" value="0.04" />

  <!-- -------- МАТЕРИАЛЫ -------- -->
  <material name="white">
    <color rgba="0.71 0.75 1 1" />
  </material>

  <material name="rose">
    <color rgba="0.812 0.604 0.659 1" />
  </material>

  <material name="orange">
    <color rgba="0.98 0.7 0.53 0.95" />
  </material>

  <material name="blue">
    <color rgba="0.65 0.9 0.63 1" />
  </material>

  <material name="black">
    <color rgba="0 0 0 1" />
  </material>

  <material name="red">
    <color rgba="1 0 0 1" />
  </material>

  <!-- -------- БАЗОВЫЕ ССЫЛКИ -------- -->
  <link name="base_link"/>
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link" />
    <child link="base_footprint" />
    <origin xyz="0 0 -0.138" rpy="0 0 0" />
  </joint>

  <!-- -------- КОРПУС -------- -->
  <joint name="chassis_joint" type="fixed">
    <parent link="base_link" />
    <child link="chassis" />
    <origin xyz="${-wheel_offset_x} 0 ${-wheel_offset_z}" />
  </joint>

  <link name="chassis">
    <inertial>
      <origin xyz="${chassis_length/2} 0 ${chassis_height/2}" rpy="0 0 0" />
      <mass value="${mass}" />
      <inertia ixx="${(1/12) * mass * (chassis_width*chassis_width+chassis_height*chassis_height)}"
               ixy="0.0" ixz="0.0"
               iyy="${(1/12) * mass * (chassis_length*chassis_length+chassis_height*chassis_height)}"
               iyz="0.0"
               izz="${(1/12) * mass * (chassis_length*chassis_length+chassis_width*chassis_width)}" />
    </inertial>
    <visual>
      <origin xyz="${chassis_length/2} 0 ${chassis_height/2}" />
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}" />
      </geometry>
      <material name="orange" />
    </visual>
    <collision>
      <origin xyz="${chassis_length/2} 0 ${chassis_height/2}" />
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}" />
      </geometry>
    </collision>
  </link>

  <gazebo reference="chassis">
    <material>Gazebo/Orange</material>
  </gazebo>

  <!-- -------- ВЕДУЩИЕ КОЛЁСА -------- -->
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="left_wheel" />
    <origin xyz="0 ${wheel_offset_y} 0" rpy="-${pi/2} 0 0" />
    <axis xyz="0 0 1" />
  </joint>

  <link name="left_wheel">
    <visual>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_thickness}" />
      </geometry>
      <material name="blue" />
    </visual>
    <collision>
      <geometry>
        <sphere radius="${wheel_radius}" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="${wheel_mass}" />
      <inertia ixx="${(1/12) * wheel_mass * (3*wheel_radius*wheel_radius + wheel_thickness*wheel_thickness)}"
               ixy="0.0" ixz="0.0"
               iyy="${(1/12) * wheel_mass * (3*wheel_radius*wheel_radius + wheel_thickness*wheel_thickness)}"
               iyz="0.0"
               izz="${(1/2) * wheel_mass * (wheel_radius*wheel_radius)}" />
    </inertial>
  </link>

  <gazebo reference="left_wheel">
    <material>Gazebo/Blue</material>
  </gazebo>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="right_wheel" />
    <origin xyz="0 ${-wheel_offset_y} 0" rpy="${pi/2} 0 0" />
    <axis xyz="0 0 -1" />
  </joint>

  <link name="right_wheel">
    <visual>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_thickness}" />
      </geometry>
      <material name="blue" />
    </visual>
    <collision>
      <geometry>
        <sphere radius="${wheel_radius}" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="${wheel_mass}" />
      <inertia ixx="${(1/12) * wheel_mass * (3*wheel_radius*wheel_radius + wheel_thickness*wheel_thickness)}"
               ixy="0.0" ixz="0.0"
               iyy="${(1/12) * wheel_mass * (3*wheel_radius*wheel_radius + wheel_thickness*wheel_thickness)}"
               iyz="0.0"
               izz="${(1/2) * wheel_mass * (wheel_radius*wheel_radius)}" />
    </inertial>
  </link>

  <gazebo reference="right_wheel">
    <material>Gazebo/Blue</material>
  </gazebo>

  <!-- -------- ОПОРНОЕ КОЛЕСО -------- -->
  <joint name="caster_wheel_joint" type="fixed">
    <parent link="chassis" />
    <child link="caster_wheel" />
    <origin xyz="${caster_wheel_offset_x} 0 ${caster_wheel_offset_z}" />
  </joint>

  <link name="caster_wheel">
    <visual>
      <geometry>
        <sphere radius="${caster_wheel_radius}" />
      </geometry>
      <material name="white" />
    </visual>
    <collision>
      <geometry>
        <sphere radius="${caster_wheel_radius}" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="${caster_wheel_mass}" />
      <inertia ixx="${(2/5) * caster_wheel_mass * (caster_wheel_radius*caster_wheel_radius)}"
               ixy="0.0" ixz="0.0"
               iyy="${(2/5) * caster_wheel_mass * (caster_wheel_radius*caster_wheel_radius)}"
               iyz="0.0"
               izz="${(2/5) * caster_wheel_mass * (caster_wheel_radius*caster_wheel_radius)}" />
    </inertial>
  </link>

  <gazebo reference="caster_wheel">
    <material>Gazebo/White</material>
    <mu1 value="0.001" />
    <mu2 value="0.001" />
  </gazebo>

  <!-- ========= ВНЕШНОСТЬ ПИТОМЦА ========= -->

  <!-- Голова-сфера -->
  <link name="body_sphere">
    <visual>
      <origin xyz="${chassis_length/2} 0 ${chassis_height + 0.17}" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.15"/>
      </geometry>
      <material name="rose"/>
    </visual>
    <collision>
      <origin xyz="${chassis_length/2} 0 ${chassis_height + 0.17}" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.15"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="${chassis_length/2} 0 ${chassis_height + 0.17}" rpy="0 0 0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
    </inertial>
  </link>

  <joint name="body_sphere_joint" type="fixed">
    <parent link="chassis"/>
    <child link="body_sphere"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <gazebo reference="body_sphere">
    <material>Gazebo/Pink</material>
  </gazebo>

  <!-- Ушки -->
  <link name="ear_left">
    <visual>
      <origin xyz="${chassis_length/2 + 0.02} 0.12 ${chassis_height + 0.23}" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.08 0.01"/>
      </geometry>
      <material name="rose"/>
    </visual>
  </link>

  <joint name="ear_left_joint" type="fixed">
    <parent link="body_sphere"/>
    <child link="ear_left"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="ear_right">
    <visual>
      <origin xyz="${chassis_length/2 + 0.02} -0.12 ${chassis_height + 0.23}" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.08 0.01"/>
      </geometry>
      <material name="rose"/>
    </visual>
  </link>

  <joint name="ear_right_joint" type="fixed">
    <parent link="body_sphere"/>
    <child link="ear_right"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Хвост -->
  <link name="tail">
    <visual>
      <origin xyz="${chassis_length*0.1} 0 ${chassis_height + 0.15}" rpy="${-pi/6} 0 0"/>
      <geometry>
        <cylinder radius="0.01" length="0.18"/>
      </geometry>
      <material name="rose"/>
    </visual>
  </link>

  <joint name="tail_joint" type="fixed">
    <parent link="chassis"/>
    <child link="tail"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Глаза-экраны -->
  <link name="eye_screen_left">
    <visual>
      <origin xyz="${chassis_length - 0.02} 0.05 ${chassis_height*0.7}" rpy="0 ${pi/2} 0"/>
      <geometry>
        <box size="0.02 0.05 0.03"/>
      </geometry>
      <material name="white"/>
    </visual>
  </link>

  <joint name="eye_screen_left_joint" type="fixed">
    <parent link="chassis"/>
    <child link="eye_screen_left"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="eye_screen_right">
    <visual>
      <origin xyz="${chassis_length - 0.02} -0.05 ${chassis_height*0.7}" rpy="0 ${pi/2} 0"/>
      <geometry>
        <box size="0.02 0.05 0.03"/>
      </geometry>
      <material name="white"/>
    </visual>
  </link>

  <joint name="eye_screen_right_joint" type="fixed">
    <parent link="chassis"/>
    <child link="eye_screen_right"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Рот -->
  <link name="mouth_screen">
    <visual>
      <origin xyz="${chassis_length - 0.021} 0 ${chassis_height*0.45}" rpy="0 ${pi/2} 0"/>
      <geometry>
        <box size="0.018 0.08 0.015"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <joint name="mouth_screen_joint" type="fixed">
    <parent link="chassis"/>
    <child link="mouth_screen"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ========= ЛИДАР (НОС) ========= -->
  <link name="laser_frame">
    <visual>
      <geometry>
        <cylinder radius="${laser_radius}" length="${laser_length}" />
      </geometry>
      <material name="black" />
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${laser_radius}" length="${laser_length}" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1" />
      <inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3" />
    </inertial>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="chassis" />
    <child link="laser_frame" />
    <origin xyz="${chassis_length} 0 ${chassis_height/2}" rpy="0 0 0" />
  </joint>

  <gazebo reference="laser_frame">
    <sensor name="laser_frame" type="gpu_lidar">
      <topic>scan</topic>
      <pose relative_to="laser_frame">0 0 0 0 0 0</pose>
      <update_rate>5</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>50</samples>
            <resolution>1</resolution>
            <min_angle>-1.396263</min_angle>
            <max_angle>1.396263</max_angle>
          </horizontal>
          <vertical>
            <samples>20</samples>
            <resolution>1</resolution>
            <min_angle>-0.65</min_angle>
            <max_angle>0.65</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.08</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

</robot>
```

Если что‑то «уползёт» в Gazebo/RViz, можно чуть подвигать координаты `origin` у головы, ушей, глаз и хвоста — логика остаётся той же.[3][4]

